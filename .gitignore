# Java 后端编译文件
zhenxinjian-backend/target/
zhenxinjian-backend/*.jar
zhenxinjian-backend/*.war
*.class

# 前端 & UniApp 依赖包（体积巨大，绝对不能传）
zhenxinjian-front/node_modules/
zhenxinjian-front/dist/

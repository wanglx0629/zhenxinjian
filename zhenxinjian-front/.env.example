# luote 前端环境变量示例
# 作者: luote (luote) - https://luote996.cn
# 使用方式: 复制为 .env.development 或 .env.production
# Vite 仅暴露 VITE_ 前缀变量到客户端

# 应用标题
VITE_APP_TITLE=zhenxinjian

# API 基础路径（开发环境走 Vite 代理）
VITE_API_BASE_URL=/api

# WebSocket 路径（相对当前站点；也可写 ws://host/api/ws/demo）
VITE_WS_PATH=/api/ws/demo
VITE_WS_PROTOCOL=bearer

# Vite 开发服务器端口
VITE_APP_PORT=5173

# Vite 代理目标（后端地址）
VITE_API_PROXY_TARGET=http://localhost:8080

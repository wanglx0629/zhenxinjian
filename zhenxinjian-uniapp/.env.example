# luote UniApp 环境变量说明
# 作者: luote (luote) - https://luote996.cn
# 复制为 .env.development / .env.production 后按需修改

# 后端 API 根路径（须含 context-path /api；小程序必须用绝对地址）
VITE_API_BASE_URL=http://localhost:8080/api

# 应用标题
VITE_APP_TITLE=zhenxinjian

# WebSocket 完整路径（含 /api 前缀）
VITE_WS_PATH=/api/ws/demo

# Sec-WebSocket-Protocol 子协议名（须与后端 zhenxinjian.websocket.protocol 一致）
VITE_WS_PROTOCOL=bearer

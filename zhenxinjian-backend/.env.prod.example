# luote 后端生产环境变量示例
# 作者: luote (luote) - https://luote996.cn
# 使用方式: 复制为 .env 后在服务器/容器中注入

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== JWT ====================
# 生产必须换成足够长的随机串（建议 >= 32），禁止沿用示例值
JWT_SECRET=

AI_DASHSCOPE_API_KEY=

CORS_ORIGINS=https://your-domain.com

# WebSocket（可选，默认见 application-prod.yml）
# WS_ENABLED=true
# WS_PATH=/ws/demo
# WS_MAX_SESSIONS=500

MINIO_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=zhenxinjian

OSS_ENABLED=true
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=zhenxinjian
OSS_CUSTOM_DOMAIN=

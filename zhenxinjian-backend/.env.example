# luote 后端环境变量示例
# 作者: luote (luote) - https://luote996.cn
# 使用方式: 复制为 .env 后按需修改
#   cp .env.example .env

# ==================== 运行环境 ====================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==================== 数据库 MySQL ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 【重要】Redis 设置了密码时，JetCache 必须单独写完整 URI（不会自动带上 REDIS_PASSWORD）
# 示例: JETCACHE_REDIS_URI=redis://:你的密码@127.0.0.1:6379/0
# JETCACHE_REDIS_URI=

# ==================== JWT ====================
# 开发可用下方示例；生产务必改为随机强密钥（见 .env.prod.example）
JWT_SECRET=zhenxinjian-jwt-secret-key-change-in-production-luote996-cn

# ==================== Spring AI Alibaba ====================
AI_DASHSCOPE_API_KEY=sk-demo-key

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==================== WebSocket（也可在 application.yml 的 luote.websocket 调整）====================
# WS_ENABLED=true
# WS_PATH=/ws/demo

# ==================== MinIO 主存储 ====================
MINIO_ENABLED=false
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zhenxinjian

# ==================== 阿里云 OSS 保底 ====================
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=zhenxinjian
OSS_CUSTOM_DOMAIN=

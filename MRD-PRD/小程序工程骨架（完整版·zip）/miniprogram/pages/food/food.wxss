.search-bar { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 20rpx; }
.search-input { flex: 1; height: 80rpx; font-size: 28rpx; }
.clear { color: #94A3A0; font-size: 32rpx; padding-left: 16rpx; }
.cats { white-space: nowrap; margin-bottom: 20rpx; }
.cat-chip { display: inline-block; padding: 10rpx 28rpx; margin-right: 16rpx; border-radius: 999rpx; background: #fff; color: #5B6B69; font-size: 24rpx; }
.cat-chip.on { background: #0D9488; color: #fff; }
.count { font-size: 24rpx; color: #94A3A0; margin-bottom: 12rpx; }
.food-item { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.fi-main { flex: 1; }
.fi-name { font-size: 30rpx; }
.fi-meta { font-size: 22rpx; color: #94A3A0; margin-top: 6rpx; }
.fi-kcal { font-size: 32rpx; font-weight: 700; color: #0D9488; }
.u { font-size: 22rpx; font-weight: 400; color: #94A3A0; }
.empty { text-align: center; color: #94A3A0; padding: 80rpx 0; }
.more { text-align: center; color: #94A3A0; font-size: 24rpx; padding: 20rpx 0; }
.note { font-size: 22rpx; color: #B9C4C2; line-height: 1.7; padding: 20rpx 8rpx; }

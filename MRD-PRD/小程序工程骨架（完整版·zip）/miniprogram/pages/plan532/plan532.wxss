.fn { font-size: 20rpx; color: #94A3A0; margin-left: 12rpx; font-weight: 400; }
.macro-grid { display: flex; }
.mg-item { flex: 1; text-align: center; }
.mg-num { font-size: 44rpx; font-weight: 800; }
.mg-num.c { color: #F59E0B; } .mg-num.p { color: #0D9488; }
.mg-num.f { color: #6366F1; } .mg-num.k { color: #0F3E3A; }
.mg-lab { font-size: 22rpx; color: #94A3A0; }
.sw-main { flex: 1; }
.sw-title { font-size: 28rpx; }
.period-form { margin-top: 24rpx; border-top: 2rpx solid #F1F5F4; padding-top: 8rpx; }
.phase-box { margin-top: 24rpx; background: #FDF2F8; border-left: 8rpx solid #DB2777; border-radius: 12rpx; padding: 20rpx; }
.pb-head { display: flex; align-items: center; }
.pb-tag { color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.pb-day { font-size: 24rpx; color: #5B6B69; margin-left: 16rpx; }
.pb-focus { font-size: 24rpx; color: #5B6B69; margin-top: 12rpx; line-height: 1.7; }
.pb-tip { font-size: 24rpx; color: #9D4B74; margin-top: 12rpx; font-weight: 600; }
.stage-card { border: 2rpx solid #F1F5F4; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.sc-head { display: flex; align-items: center; justify-content: space-between; }
.sc-name { font-size: 30rpx; font-weight: 700; }
.sc-macros { display: flex; margin-top: 12rpx; font-size: 24rpx; color: #5B6B69; }
.sc-macros text { margin-right: 20rpx; }
.sc-kcal { color: #0D9488; font-weight: 700; }
.sc-desc { font-size: 24rpx; color: #94A3A0; margin-top: 12rpx; line-height: 1.7; }

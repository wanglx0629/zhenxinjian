.seg { display: flex; gap: 20rpx; }
.seg-item { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center;
  border: 2rpx solid #E4EBE9; border-radius: 16rpx; color: #5B6B69; }
.seg-item.on { background: #E6F5F3; border-color: #0D9488; color: #0D9488; font-weight: 700; }
.fn { font-size: 20rpx; color: #94A3A0; margin-left: 12rpx; font-weight: 400; }
.picker-line { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; }
.picker-val { color: #0D9488; }

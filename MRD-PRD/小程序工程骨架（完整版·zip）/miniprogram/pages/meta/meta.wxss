.hero-card { background: linear-gradient(135deg, #0D9488, #14B8A6); color: #fff; text-align: center; }
.hero-label { font-size: 26rpx; opacity: .9; }
.hero-num { font-size: 80rpx; font-weight: 800; line-height: 1.2; }
.unit { font-size: 28rpx; font-weight: 400; opacity: .85; }
.hero-sub { font-size: 24rpx; opacity: .85; }
.fn { font-size: 20rpx; color: #94A3A0; margin-left: 12rpx; font-weight: 400; }
.grid { display: flex; gap: 16rpx; }
.grid-item { flex: 1; text-align: center; padding: 24rpx 0; border: 2rpx solid #E4EBE9; border-radius: 16rpx; }
.grid-item.on { background: #E6F5F3; border-color: #0D9488; }
.gi-num { font-size: 34rpx; font-weight: 800; color: #0D9488; }
.gi-lab { font-size: 22rpx; color: #94A3A0; }
.note { font-size: 24rpx; color: #5B6B69; margin-top: 16rpx; line-height: 1.8; }
.big { font-size: 32rpx; padding: 12rpx 0; }
.hl { font-size: 40rpx; font-weight: 800; color: #0D9488; }

.f-head { }
.f-name { font-size: 36rpx; font-weight: 700; }
.f-cat { font-size: 24rpx; color: #94A3A0; margin-top: 4rpx; }
.f-base { font-size: 26rpx; color: #5B6B69; margin-top: 16rpx; }
.dry-tip { margin-top: 20rpx; background: #FFFBEB; border: 2rpx solid #FDE68A; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 24rpx; color: #92400E; }
.fn { font-size: 20rpx; color: #94A3A0; margin-left: 12rpx; font-weight: 400; }
.qty-row { display: flex; align-items: center; justify-content: center; }
.qty-btn { width: 140rpx; height: 80rpx; line-height: 80rpx; text-align: center; border: 2rpx solid #E4EBE9; border-radius: 16rpx; }
.qty-input { width: 180rpx; text-align: center; font-size: 48rpx; font-weight: 800; color: #0D9488; }
.qty-unit { font-size: 30rpx; color: #94A3A0; }
.quick-qty { display: flex; justify-content: center; gap: 20rpx; margin-top: 24rpx; }
.qq { font-size: 24rpx; color: #0D9488; padding: 8rpx 24rpx; border: 2rpx solid #E4EBE9; border-radius: 999rpx; }
.macro-grid { display: flex; }
.mg { flex: 1; text-align: center; }
.mg-num { font-size: 40rpx; font-weight: 800; }
.mg-num.c { color: #F59E0B; } .mg-num.p { color: #0D9488; }
.mg-num.f { color: #6366F1; } .mg-num.k { color: #0F3E3A; }
.mg-lab { font-size: 22rpx; color: #94A3A0; }
.picker-line { display: flex; justify-content: space-between; padding: 12rpx 0; }
.pv { color: #0D9488; }

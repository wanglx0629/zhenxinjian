.hero { background: linear-gradient(135deg, #0D9488, #14B8A6); color: #fff; padding: 36rpx 32rpx 44rpx; }
.h-top { display: flex; justify-content: space-between; align-items: flex-start; }
.h-date { font-size: 26rpx; opacity: .9; }
.h-mode { font-size: 34rpx; font-weight: 700; margin-top: 4rpx; }
.h-phase { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #fff; }
.h-kcal { margin-top: 28rpx; }
.hk-num { font-size: 64rpx; font-weight: 800; }
.hk-sep { font-size: 36rpx; opacity: .7; margin: 0 8rpx; }
.hk-tgt { font-size: 36rpx; opacity: .9; }
.hk-unit { font-size: 24rpx; opacity: .8; margin-left: 8rpx; }
.progress { height: 12rpx; background: rgba(255,255,255,.25); border-radius: 6rpx; margin-top: 20rpx; overflow: hidden; }
.progress-in { height: 100%; background: #fff; border-radius: 6rpx; }
.fn { font-size: 20rpx; color: #94A3A0; margin-left: 12rpx; font-weight: 400; }
.mac-row { display: flex; align-items: center; margin-top: 20rpx; }
.mac-lab { flex: 1; font-size: 28rpx; }
.mac-val { font-size: 26rpx; color: #5B6B69; }
.bar { height: 10rpx; background: #F1F5F4; border-radius: 5rpx; margin-top: 10rpx; overflow: hidden; }
.bar-in { height: 100%; border-radius: 5rpx; }
.bc { background: #F59E0B; } .bp { background: #0D9488; } .bf { background: #6366F1; }
.over-card { background: #FFFBEB; border: 2rpx solid #FDE68A; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { background: #FEF3C7; color: #B45309; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 999rpx; }
.advice { font-size: 26rpx; color: #92400E; margin-top: 16rpx; line-height: 1.7; }
.quick { display: flex; }
.q-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 26rpx; }
.q-icon { display: block; font-size: 44rpx; margin-bottom: 8rpx; }
.empty-wrap { padding: 120rpx 60rpx; text-align: center; }
.empty-wrap .empty { color: #94A3A0; margin-bottom: 40rpx; }

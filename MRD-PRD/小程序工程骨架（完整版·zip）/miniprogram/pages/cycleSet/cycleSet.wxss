.seg { display: flex; gap: 20rpx; }
.seg-item { flex: 1; padding: 24rpx 0; text-align: center; border: 2rpx solid #E4EBE9; border-radius: 16rpx; color: #5B6B69; }
.seg-item.on { background: #E6F5F3; border-color: #0D9488; color: #0D9488; font-weight: 700; }
.si-sub { display: block; font-size: 20rpx; color: #94A3A0; font-weight: 400; margin-top: 4rpx; }
.fn { font-size: 20rpx; color: #94A3A0; margin-left: 12rpx; font-weight: 400; }
.inline-input { width: 100%; height: 80rpx; border: 2rpx solid #E4EBE9; border-radius: 12rpx; padding: 0 20rpx; }
.note { font-size: 24rpx; color: #5B6B69; margin-top: 16rpx; line-height: 1.7; }
.day-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.day-item { width: 100rpx; padding: 16rpx 0; text-align: center; border: 2rpx solid #E4EBE9; border-radius: 12rpx; }
.day-item.on { background: #0D9488; border-color: #0D9488; color: #fff; }
.di-day { font-size: 30rpx; font-weight: 800; }
.di-lab { font-size: 20rpx; opacity: .8; }

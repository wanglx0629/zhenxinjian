<!-- P15 我的 -->
<view class="container">
  <view class="card profile">
    <view class="pf-name">{{isGuest ? '游客用户' : '已登录用户'}}</view>
    <view class="pf-sub">当前模式：{{modeLabel}}</view>
  </view>

  <view class="card">
    <view class="list-item" data-url="/pages/body/body" bindtap="go">
      <view class="li-main"><view class="li-title">身体数据</view><view class="li-sub">修改性别 / 年龄 / 身高 / 体重</view></view>
      <text class="li-arrow">›</text>
    </view>
    <view class="list-item" data-url="/pages/switch/switch" bindtap="go">
      <view class="li-main"><view class="li-title">减脂模式</view><view class="li-sub">当前：{{modeLabel}}</view></view>
      <text class="li-arrow">›</text>
    </view>
    <view class="list-item" data-url="/pages/remind/remind" bindtap="go">
      <view class="li-main"><view class="li-title">提醒设置</view><view class="li-sub">三餐提醒时间</view></view>
      <text class="li-arrow">›</text>
    </view>
    <view class="list-item" data-url="/pages/weight/weight" bindtap="go">
      <view class="li-main"><view class="li-title">体重记录</view><view class="li-sub">查看趋势与平台期</view></view>
      <text class="li-arrow">›</text>
    </view>
    <view class="list-item" bindtap="onPrivacy">
      <view class="li-main"><view class="li-title">隐私与安全</view><view class="li-sub">隐私数据加密存储 · 禁止明文传输</view></view>
      <text class="li-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="list-item" bindtap="onClear">
      <view class="li-main"><view class="li-title danger">清空本地数据</view></view>
      <text class="li-arrow">›</text>
    </view>
  </view>

  <view class="disclaimer">本应用提供饮食与运动建议，不构成医疗建议。孕期、哺乳期及慢性病人群请遵医嘱。</view>
</view>
